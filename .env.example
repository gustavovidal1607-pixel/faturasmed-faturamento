# String de conexão do banco Neon (Postgres). Criar um banco novo em
# https://neon.tech e colar aqui a connection string fornecida.
DATABASE_URL=

# Chave simétrica usada para cifrar/decifrar dados sensíveis (login/senha
# de portal de convênio, guardados no cadastro de Vínculos). Precisa ter
# exatamente 32 bytes.
# Gerar uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e colar o valor gerado (64 caracteres hexadecimais) aqui.
VINCULOS_CIFRA_KEY=
